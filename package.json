{
  "name": "@garvitgandhi/dotenv-doctor",
  "version": "0.1.1",
  "description": "Catch environment configuration errors before they break your application",
  "main": "dist/cli.js",
  "bin": {
    "dotenv-doctor": "dist/cli.js",
    "envdoctor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "node --test --require tsx/cjs tests/**/*.test.ts",
